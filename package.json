{
  "name": "odonavig",
  "productName": "Odonavig",
  "version": "1.0.0",
  "description": "Odonavig - un navigateur web ultra simple",
  "main": "src/main.js",
  "author": "Odonavig",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "fr.odonavig.browser",
    "productName": "Odonavig",
    "copyright": "Odonavig",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/utif/**/*",
      "node_modules/pako/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Odonavig"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Odonavig",
      "artifactName": "Odonavig-Setup-${version}.exe",
      "perMachine": false
    },
    "portable": {
      "artifactName": "Odonavig-Portable-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "svg",
          "ico",
          "avif",
          "tif",
          "tiff"
        ],
        "name": "Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "Page web",
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "artifactName": "Odonavig-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "Odonavig",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Odonavig",
      "artifactName": "Odonavig-${version}-mac-${arch}.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "protocols": [
      {
        "name": "Page web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ]
  }
}
